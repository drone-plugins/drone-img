FROM alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a AS ca-certificates
RUN apk add --no-cache 'ca-certificates>=20261020-r0'

FROM jess/img@sha256:afdfe8aaef3891667b89c865540d92615263f855c9a591b15c9356f08f0e4dc4
USER root
RUN apk add --no-cache ca-certificates
COPY --from=ca-certificates /usr/share/ca-certificates/ /usr/share/ca-certificates/
COPY --from=ca-certificates /etc/ca-certificates.conf /etc/ca-certificates.conf
RUN update-ca-certificates --fresh \
    && ln -sf certs/ca-certificates.crt /etc/ssl/cert.pem
USER user

ADD release/linux/amd64/drone-ecr /bin/
ENTRYPOINT ["/bin/drone-ecr"]
